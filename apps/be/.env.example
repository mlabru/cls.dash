# Modelo do arquivo de ambiente do backend (apps/be).
# Copie para .env e ajuste os valores.

# Arquivo de configuração do dashboard (relativo ao diretório apps/be)
CONFIG_FILE=config.json

# Servidor
HOST=0.0.0.0
PORT=8000

# NUNCA "true" com HOST=0.0.0.0: o debugger do Werkzeug fica acessível pela
# rede e permite executar código no servidor. Só em desenvolvimento local,
# de preferência com HOST=127.0.0.1.
FLASK_DEBUG=false

# Origens permitidas pelo CORS — deve ser a origem do frontend
# Ex: http://localhost:8080, http://videowall:8080
CORS_ORIGINS=http://localhost:8080
